#!/usr/bin/env bash
# Refuse early when the requested version does not exist, so nobody installs a
# toolchain for a Python that was never released.
#
# The build prerequisites are checked by polyvm itself, from
# contrib/requirements/python, for every language rather than only this one.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/helpers.sh"

[ -n "${ASDF_INSTALL_VERSION:-}" ] || exit 0
[ "${ASDF_INSTALL_TYPE:-version}" = "version" ] || exit 0

check_version_exists "$ASDF_INSTALL_VERSION"
