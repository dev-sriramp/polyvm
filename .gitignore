# Runtime data. These appear only when polyvm's data dir is the checkout
# itself, which is the normal install (a clone into ~/.polyvm).
#
# Every one of these is anchored with a leading slash. Without it git matches
# the pattern at any depth, and an unanchored "plugins/" also excludes
# contrib/plugins, quietly dropping the built-in plugins from the repository.
/shims/
/installs/
/downloads/
/plugins/
/tmp/
/cache/
/plugin-index/
/compat/
/versions
/.update-check

# Editor and OS files, which should be ignored at any depth.
.DS_Store
*.swp
*~
.idea/
.vscode/

# Test scratch
/test/tmp/
